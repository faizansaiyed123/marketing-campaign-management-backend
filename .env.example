ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campaigns
# Development-only Docker Compose credentials. Use unique random values in production.
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=development-only-redis-password
# For running the API directly outside Compose, use a localhost URL with the same
# password as REDIS_PASSWORD (URL-safe hex secrets are recommended).
REDIS_URL=redis://:development-only-redis-password@localhost:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_NAME=campaign_session
PUBLIC_BASE_URL=http://localhost:8000
# SMTP is optional in development but required for production startup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional docker-compose.production.yml Caddy overlay; use your real public domains.
# FRONTEND_DOMAIN=app.example.com
# API_DOMAIN=api.example.com
